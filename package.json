{
  "name": "nanal-life-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "build:site": "npm run build && node scripts/build-site-worker.mjs",
    "verify:site": "npm run build:site && node scripts/verify-site-worker.mjs",
    "test": "vitest run && node --test server/image-queue/policy.node-test.mjs server/chatgpt-import/bridge.node-test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.25.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
