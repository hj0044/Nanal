{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nanal-game",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "build": {
    "command": "npm run build:site"
  },
  "d1_databases": [
    {
      "binding": "NANAL_APPEARANCE_DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NANAL_APPEARANCE_IMAGES"
    }
  ]
}
